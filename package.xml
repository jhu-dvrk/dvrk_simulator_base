<?xml version="1.0"?>
<package format="3">
  <name>dvrk_simulator_base</name>
  <version>0.1.0</version>
  <description>Simulator-independent CRTK behavior and contracts for dVRK simulators.</description>
  <maintainer email="anton.deguet@jhu.edu">Anton Deguet</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>crtk_msgs</exec_depend>
  <exec_depend>crtk_python_client</exec_depend>
  <exec_depend>dvrk_arm_description</exec_depend>
  <exec_depend>dvrk_model</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
