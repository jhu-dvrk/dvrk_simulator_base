<robot name="dvrk_pybullet_interaction_tray">
  <link name="tray">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry><box size="0.220 0.160 0.010"/></geometry>
      <material name="tray_gray"><color rgba="0.34 0.38 0.42 1"/></material>
    </visual>
    <collision><origin xyz="0 0 -0.005"/><geometry><box size="0.220 0.160 0.010"/></geometry></collision>
    <visual><origin xyz="0.105 0 0.0055"/><geometry><box size="0.010 0.160 0.021"/></geometry><material name="tray_gray"/></visual>
    <collision><origin xyz="0.105 0 0.0055"/><geometry><box size="0.010 0.160 0.021"/></geometry></collision>
    <visual><origin xyz="-0.105 0 0.0055"/><geometry><box size="0.010 0.160 0.021"/></geometry><material name="tray_gray"/></visual>
    <collision><origin xyz="-0.105 0 0.0055"/><geometry><box size="0.010 0.160 0.021"/></geometry></collision>
    <visual><origin xyz="0 0.075 0.0055"/><geometry><box size="0.220 0.010 0.021"/></geometry><material name="tray_gray"/></visual>
    <collision><origin xyz="0 0.075 0.0055"/><geometry><box size="0.220 0.010 0.021"/></geometry></collision>
    <visual><origin xyz="0 -0.075 0.0055"/><geometry><box size="0.220 0.010 0.021"/></geometry><material name="tray_gray"/></visual>
    <collision><origin xyz="0 -0.075 0.0055"/><geometry><box size="0.220 0.010 0.021"/></geometry></collision>
  </link>
</robot>
