<?xml version="1.0"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<robot name="dvrk_torus_ring">
  <material name="ring_red">
    <color rgba="0.95 0.25 0.10 1.0"/>
  </material>
  <link name="ring">
    <contact>
      <lateral_friction value="1.0"/>
      <rolling_friction value="0.001"/>
      <spinning_friction value="0.001"/>
      <contact_cfm value="0.0"/>
      <contact_erp value="1.0"/>
    </contact>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <!-- Hollow cylinder / torus approx inertia: Izz = m * R^2, Ixx = Iyy = 0.5 * m * R^2 -->
      <inertia ixx="0.0000001" ixy="0" ixz="0" iyy="0.0000001" iyz="0" izz="0.00000018"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/ring.obj"/>
      </geometry>
      <material name="ring_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/ring_vhacd.obj"/>
      </geometry>
    </collision>
  </link>
</robot>
