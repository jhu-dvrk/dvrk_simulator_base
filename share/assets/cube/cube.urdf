<robot name="dvrk_simulator_grasp_cube">
  <link name="cube">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.012"/>
      <inertia ixx="0.0000008" ixy="0" ixz="0" iyy="0.0000008" iyz="0" izz="0.0000008"/>
    </inertial>
    <visual>
      <geometry><box size="0.020 0.020 0.020"/></geometry>
      <material name="cube_green"><color rgba="0.12 0.72 0.26 1"/></material>
    </visual>
    <collision><geometry><box size="0.020 0.020 0.020"/></geometry></collision>
    <contact><lateral_friction value="1.0"/></contact>
  </link>
</robot>
