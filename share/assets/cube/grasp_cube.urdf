<robot name="dvrk_simulator_grasp_cube">
  <link name="grasp_cube">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0000000107" ixy="0" ixz="0"
               iyy="0.0000000107" iyz="0" izz="0.0000000107"/>
    </inertial>
    <visual>
      <geometry><box size="0.008 0.008 0.008"/></geometry>
      <material name="grasp_cube_orange"><color rgba="0.95 0.42 0.08 1"/></material>
    </visual>
    <collision><geometry><box size="0.008 0.008 0.008"/></geometry></collision>
    <contact>
      <lateral_friction value="1.0"/>
      <rolling_friction value="0.001"/>
      <spinning_friction value="0.001"/>
    </contact>
  </link>
</robot>
